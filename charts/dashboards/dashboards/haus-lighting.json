{
    "id": null,
    "uid": "haus-lighting",
    "title": "Haus Lighting & Sockets",
    "description": "KNX lighting switch states, dimmer values, brightness levels and socket states.",
    "tags": [
        "haus",
        "knx",
        "lighting",
        "sockets"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {},
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "-- Grafana --"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Light Switches — Current",
            "description": "Current on/off state of each KNX light switch feedback (LightingFunction = SW_FB).",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-yellow",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_lighting_sw_fb",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Sockets — Current",
            "description": "Current on/off state of each KNX socket feedback (PowerOutletFunction = SD_FB).",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_power_outlet_sd_fb",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "state-timeline",
            "title": "Light Switches — History",
            "description": "State timeline showing when lights were switched on or off.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-yellow",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "custom": {
                        "fillOpacity": 80,
                        "lineWidth": 0
                    }
                },
                "overrides": []
            },
            "options": {
                "showValue": "auto",
                "alignValue": "center",
                "mergeValues": true,
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "rowHeight": 0.8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_lighting_sw_fb",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "type": "state-timeline",
            "title": "Sockets — History",
            "description": "State timeline showing when power outlet sockets were switched on or off.",
            "gridPos": {
                "x": 12,
                "y": 5,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "custom": {
                        "fillOpacity": 80,
                        "lineWidth": 0
                    }
                },
                "overrides": []
            },
            "options": {
                "showValue": "auto",
                "alignValue": "center",
                "mergeValues": true,
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "rowHeight": 0.8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_power_outlet_sd_fb",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Dimmer Values",
            "description": "Current dimmer output percentage from KNX group addresses (LightingFunction = VFB).",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "min",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_lighting_vfb_percent",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Brightness Levels",
            "description": "Ambient brightness / lux readings from KNX group addresses (LightingFunction = LUX).",
            "gridPos": {
                "x": 12,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "lux",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "min",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_lighting_lux_lx",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
            ]
        }
    ]
}