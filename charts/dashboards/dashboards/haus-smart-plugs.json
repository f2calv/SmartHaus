{
    "id": null,
    "uid": "haus-smart-plugs",
    "title": "Haus Smart Plugs",
    "description": "Shelly smart plug metrics: power consumption, relay state, device temperature and overpower alerts.",
    "tags": [
        "haus",
        "shelly",
        "smart-plugs"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {},
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "-- Grafana --"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Relay State — Current",
            "description": "Current on/off state of each Shelly smart plug relay.",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_relay_state",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Overpower Alert — Current",
            "description": "Overpower condition per Shelly smart plug (1 = triggered, 0 = normal).",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Normal",
                                    "color": "semi-dark-green",
                                    "index": 0
                                },
                                "1": {
                                    "text": "Overpower!",
                                    "color": "semi-dark-red",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_overpower",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Power Consumption",
            "description": "Instantaneous power consumption per Shelly smart plug in Watts.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "watt",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "min",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_power_watts",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Device Temperature",
            "description": "Internal temperature readings per Shelly smart plug in Celsius.",
            "gridPos": {
                "x": 12,
                "y": 5,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 70
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "min",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_temperature_celsius",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "type": "state-timeline",
            "title": "Relay State — History",
            "description": "State timeline showing when Shelly smart plugs were switched on or off.",
            "gridPos": {
                "x": 0,
                "y": 13,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Off",
                                    "color": "semi-dark-blue",
                                    "index": 0
                                },
                                "1": {
                                    "text": "On",
                                    "color": "semi-dark-green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "custom": {
                        "fillOpacity": 80,
                        "lineWidth": 0
                    }
                },
                "overrides": []
            },
            "options": {
                "showValue": "auto",
                "alignValue": "center",
                "mergeValues": true,
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "rowHeight": 0.8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_relay_state",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 6,
            "type": "state-timeline",
            "title": "Overpower Alert — History",
            "description": "State timeline showing when Shelly smart plugs triggered overpower conditions.",
            "gridPos": {
                "x": 12,
                "y": 13,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "Normal",
                                    "color": "semi-dark-green",
                                    "index": 0
                                },
                                "1": {
                                    "text": "Overpower!",
                                    "color": "semi-dark-red",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "custom": {
                        "fillOpacity": 80,
                        "lineWidth": 0
                    }
                },
                "overrides": []
            },
            "options": {
                "showValue": "auto",
                "alignValue": "center",
                "mergeValues": true,
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "rowHeight": 0.8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_smartplug_overpower",
                    "legendFormat": "{{device_id}}",
                    "refId": "A"
                }
            ]
        }
    ]
}