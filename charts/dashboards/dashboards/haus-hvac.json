                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "rowHeight": 0.8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "haus_knx_hvac_window",
                    "legendFormat": "{{group_address_name}}",
                    "refId": "A"
                }
