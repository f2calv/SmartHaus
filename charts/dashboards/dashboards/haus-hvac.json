        {
            "id": 9,
            "type": "timeseries",
            "title": "Boiler Temperatures (Buderus KM200)",
            "description": "Heating system temperatures from the Buderus KM200 boiler gateway, differentiated by datapoint.",
            "gridPos": {
                "x": 0,
                "y": 28,
                "w": 24,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
