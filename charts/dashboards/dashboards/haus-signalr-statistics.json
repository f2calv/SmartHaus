{
    "id": null,
    "uid": "haus-signalr-stats",
    "title": "Haus SignalR Statistics",
    "description": "SignalR hub event metrics published by HausHubSinkMetricsService.",
    "tags": [
        "haus",
        "signalr"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {},
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "-- Grafana --"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "templating": {
        "list": [
            {
                "name": "hub_name",
                "type": "query",
                "label": "Hub",
                "datasource": {
                    "type": "prometheus",
                    "uid": "{{ .Values.datasources.prometheus }}"
                },
                "query": "label_values(haus_signalrhub_events_total, hub_name)",
                "refresh": 2,
                "multi": false,
                "includeAll": true,
                "allValue": ".*",
                "current": {}
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Total Hub Events (last 1h)",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 100000
                            },
                            {
                                "color": "red",
                                "value": 1000000
                            }
                        ]
                    },
                    "mappings": []
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "increase(haus_signalrhub_events_total{hub_name=~\"$hub_name\"}[1h])",
                    "legendFormat": "Total",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Distinct Event Types",
            "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "mappings": []
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "none"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "count(count by (event_type) (haus_signalrhub_events_total{hub_name=~\"$hub_name\"}))",
                    "legendFormat": "Types",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Event Rate by Type (per minute)",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 24,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "mappings": []
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "rate(haus_signalrhub_events_total{hub_name=~\"$hub_name\"}[1m]) * 60",
                    "legendFormat": "{{event_type}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "type": "bargauge",
            "title": "Cumulative Events by Type",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "mappings": []
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "horizontal",
                "displayMode": "gradient"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "increase(haus_signalrhub_events_total{hub_name=~\"$hub_name\"}[24h])",
                    "legendFormat": "{{event_type}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Total Event Rate (all types, per second)",
            "gridPos": {
                "x": 12,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15
                    },
                    "mappings": []
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "sum(rate(haus_signalrhub_events_total{hub_name=~\"$hub_name\"}[1m]))",
                    "legendFormat": "Events/s",
                    "refId": "A"
                }
            ]
        }
    ]
}