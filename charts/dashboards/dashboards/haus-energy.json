        {
            "id": 5,
            "type": "timeseries",
            "title": "Power Flow",
            "description": "Solar PV generation, house load, battery charge/discharge and grid import/export over time.",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "prometheus",
                "uid": "{{ .Values.datasources.prometheus }}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "watt",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 5
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "PV"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#ff9800",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Load"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#f44336",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Battery"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#4caf50",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Grid"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#2196f3",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "min",
                        "max",
                        "mean"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "max(haus_inverter_pv_power_watts)",
                    "legendFormat": "PV",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "{{ .Values.datasources.prometheus }}"
                    },
                    "expr": "abs(max(haus_inverter_load_power_watts))",
                    "legendFormat": "Load",
                    "refId": "B"
