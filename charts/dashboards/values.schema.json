{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "dashboardFolder",
    "datasources"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "dashboardFolder": {
      "type": "string",
      "minLength": 1
    },
    "datasources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prometheus"
      ],
      "properties": {
        "prometheus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "global": {
      "type": "object"
    }
  }
}
