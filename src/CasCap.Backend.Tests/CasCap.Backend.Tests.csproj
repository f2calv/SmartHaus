  <ItemGroup>
    <ProjectReference Include="..\CasCap.Api.Knx\CasCap.Api.Knx.csproj" />
    <ProjectReference Include="..\CasCap.Backend\CasCap.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
